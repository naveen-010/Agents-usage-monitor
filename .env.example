# ---- Dashboard auth ----
# Password required to open the dashboard and change settings.
# If left blank, the dashboard is UNPROTECTED (only acceptable on a private LAN / Tailscale).
DASHBOARD_PASSWORD=change-me

# ---- Storage ----
# SQLite file and the encryption key file live under this directory.
DATA_DIR=./data

# Fernet key used to encrypt stored provider credentials.
# Leave blank to auto-generate one into DATA_DIR/secret.key (kept 0600).
SECRET_KEY=

# Public HTTPS URL where your phone reaches the dashboard (e.g. Tailscale Serve
# hostname). Required for the "Refresh" button inside phone notifications to work.
PUBLIC_URL=

# Secret gating the notification Refresh action. Leave blank to auto-generate one
# into DATA_DIR/refresh.token.
REFRESH_TOKEN=

# ---- Polling ----
# How often (seconds) to auto-refresh usage from each provider. The server polls
# on this interval 24/7 (independent of the browser); each poll records a history
# point. Default 120 = every 2 minutes.
POLL_INTERVAL_SECONDS=120

# Usage thresholds (percent) that trigger a notification when first crossed.
USAGE_THRESHOLDS=75,80,90,100

# ---- Notifications: ntfy ----
# Self-hosted or public ntfy. Subscribe to the topic in the ntfy Android app.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
# Optional access token for protected ntfy servers.
NTFY_TOKEN=

# ---- Notifications: Telegram ----
# Create a bot via @BotFather, then message it once so it can DM you.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Notifications: Discord ----
# Channel → Edit Channel → Integrations → Webhooks → New Webhook → Copy URL.
DISCORD_WEBHOOK_URL=
